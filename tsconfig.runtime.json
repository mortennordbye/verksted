// The files shipped into the image but built by nobody: verksted-mcp.mjs is
// 1,645 lines of plain JS that destructures backend responses, and until this
// existed nothing checked that a field it reads off a response is a field the
// response has (A-30 in the audit). Checked as JavaScript — no build step, no
// types to write out — so the cost is JSDoc where an inference cannot reach.
//
// Strict, noImplicitAny included: every backend answer is named by its wire
// type from shared/api.ts at the call site, and `call()` answers `unknown`
// where nobody did. Run by `npm run lint:runtime`.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["runtime/**/*.mjs"]
}
