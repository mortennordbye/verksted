#!/bin/sh
# verksted sandbox helper. `vk doctor` reports what this session's docker and
# cluster access actually are right now; /etc/verksted/SANDBOX.md explains why.
#
# The bind-mount probe is the point of the command: a daemon that cannot see the
# working directory mounts an empty one instead of failing, so the only reliable
# way to know is to ask the daemon what it sees.
set -eu

PROBE_IMAGE=busybox:stable

# The volume, and where its exports land on it. VK_DATA_DIR is for testing the
# backup path against a scratch tree; the app itself never reads it.
DATA_DIR=${VK_DATA_DIR:-/data}
# Where the archives land. In the pod this points at an NFS mount off the NAS,
# so an export is not sitting on the volume it exists to replace; without it,
# beside the data it came from, which is all a laptop or `make run` can offer.
BACKUP_DIR=${VK_BACKUP_DIR:-$DATA_DIR/backups}
MIN_FREE_KB=10485760
DEFAULT_KEEP=7
# When set, an archive is encrypted with it and carries a .enc suffix.
#
# Deliberately opt-in, and deliberately not defaulted to anything: an archive
# nobody can decrypt is worse than one anybody can read. The passphrase has to
# live somewhere that is not this volume — a password manager — because the
# volume is the thing the archive exists to replace, and a key stored inside
# what it protects protects nothing.
PASSPHRASE=${VK_BACKUP_PASSPHRASE:-}
export VK_BACKUP_PASSPHRASE

# What an archive is, rather than what its name says: openssl writes "Salted__"
# as the first eight bytes. The suffix is a label, this is the fact.
is_encrypted() { [ "$(head -c 8 "$1" 2>/dev/null)" = "Salted__" ]; }

# AES-256 under a PBKDF2-stretched passphrase. `openssl enc` carries no MAC, so
# this buys confidentiality from anyone who can read the share — which is the
# point, the share is the one the media sits on — and not proof that an archive
# was never rewritten. The sha256 beside it catches the corruption that actually
# happens; a NAS that is being tampered with is a different problem.
encrypt() {
  openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt \
    -pass env:VK_BACKUP_PASSPHRASE -in "$1" -out "$2"
}
decrypt() {
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 \
    -pass env:VK_BACKUP_PASSPHRASE -in "$1"
}

# One archive's manifest, encrypted or not, empty when it cannot be read —
# which includes an encrypted archive on a bench with no passphrase. The
# manifest is the first member, so --occurrence=1 stops tar there rather than
# decompressing (and decrypting) the whole thing.
read_manifest() {
  if is_encrypted "$1"; then
    [ -n "$PASSPHRASE" ] || return 0
    decrypt "$1" 2>/dev/null \
      | tar -xzO --occurrence=1 .verksted-backup/MANIFEST.json 2>/dev/null || true
  else
    tar -xzOf "$1" --occurrence=1 .verksted-backup/MANIFEST.json 2>/dev/null || true
  fi
}

usage() {
  echo "usage: vk doctor              report this session's docker and cluster topology"
  echo "       vk feedback TEXT      tell the owner what verksted itself is missing"
  echo "       vk backup [--out DIR] [--name NAME] [--keep N]"
  echo "                             export all of $DATA_DIR to one tar.gz"
  echo "       vk restore ARCHIVE [--target DIR] [--force]"
  echo "                             import one back"
  echo "       vk backups [DIR] [--json]"
  echo "                             list the archives in $BACKUP_DIR"
  echo
  echo "/etc/verksted/SANDBOX.md explains what the doctor report means."
}

# What kubectl can actually do from here, asked rather than assumed. The answer
# is the apiserver's: the RBAC bound to this pod's ServiceAccount is a manifest
# in another repo and may have moved since anyone wrote a doc about it.
can() { kubectl auth can-i "$@" --all-namespaces 2>/dev/null || true; }

cluster() {
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "cluster          kubectl is not installed in this image"
  elif ! who=$(kubectl auth whoami -o jsonpath='{.status.userInfo.username}' 2>/dev/null); then
    # No token, or one the apiserver will not accept. Both mean the same thing
    # to a session: do not plan on reading the cluster from here.
    echo "cluster          none reachable - no usable ServiceAccount token here"
  else
    echo "cluster          reachable as $who"
    echo "                 get pods $(can get pods), get secrets $(can get secrets)," \
         "create deployments $(can create deployments)"
  fi
}

# Where the backend answers from inside a session. Always this pod, always this
# port: the app and the session share a network namespace, whatever the tunnel
# in front of it looks like.
API=${VK_API:-http://127.0.0.1:8080}

# A note about the bench, not about the repo. The text is the request body
# verbatim, so no quoting of it into JSON has to happen in sh; the session id
# rides along as a query parameter and the backend reads the repo off it.
feedback() {
  if [ -z "${1:-}" ]; then
    echo "vk feedback: say what is missing, in one or two sentences" >&2
    exit 1
  fi
  url="$API/api/feedback"
  # An `x && y` list whose left side fails is itself a failed command, and this
  # script runs under `set -e`: written that way, a session with no id in its
  # environment would exit here instead of filing the note.
  if [ -n "${VK_SESSION_ID:-}" ]; then
    url="$url?session=$VK_SESSION_ID"
  fi
  if printf '%s' "$*" |
    curl -fsS -X POST -H 'Content-Type: text/plain' --data-binary @- "$url" >/dev/null; then
    echo "filed. it lands in the inbox for review; nothing else is needed."
  else
    echo "vk feedback: could not reach verksted at $API" >&2
    exit 1
  fi
}

doctor() {
  echo "cwd              $PWD"
  echo "DOCKER_HOST      ${DOCKER_HOST:-unset}"

  if ! server=$(docker version --format '{{.Server.Version}}' 2>/dev/null); then
    echo "daemon           UNREACHABLE - no container work is possible here"
    exit 1
  fi
  echo "daemon           reachable, docker $server (a sibling container, not this one)"

  # Ports are published into the daemon's network namespace, so they answer on
  # the daemon's host, which is only "localhost" when it shares this netns.
  case "${DOCKER_HOST:-}" in
    *://*)
      host=${DOCKER_HOST#*://}
      host=${host%%:*}
      ;;
    *) host=127.0.0.1 ;;
  esac
  echo "published ports  answer at $host:<port>"

  cluster

  here=$(ls -A . 2>/dev/null | wc -l | tr -d ' ')
  there=$(docker run --rm -v "$PWD:/probe" "$PROBE_IMAGE" ls -A /probe 2>/dev/null | wc -l | tr -d ' ')
  echo "bind-mount probe this container sees $here entries here, the daemon sees $there"
  if [ "$here" -gt 0 ] && [ "$there" -eq 0 ]; then
    echo "                 BROKEN: bind mounts of $PWD land empty. Only paths under"
    echo "                 /data reach the daemon; see /etc/verksted/SANDBOX.md."
    exit 1
  fi
  echo "                 ok: bind mounts of $PWD reach the daemon"
}

die() { echo "vk: $*" >&2; exit 1; }

# Everything verksted knows lives in files under $DATA_DIR and nowhere else: no
# database, and — unusually — no Kubernetes Secret either, so the agent tokens
# and OAuth state are files on the volume like the rest. That makes one tar the
# whole export, and it also means the archive is as sensitive as the volume is.
# Hence 0600 on the way out, and a loud line about where not to leave it.

# The caches are what turn a 23G volume into a 900M archive. Everything listed
# here is rebuilt on demand by the tool that owns it; nothing here is state.
# Patterns are unanchored, so a bare name matches that component at any depth.
excludes() {
  cat <<'EOF'
./backups
./.verksted-backup
./home/.cache
./home/.npm
./home/.rustup
./home/.cargo
./home/.local
./home/.claude/cache
./home/.claude/paste-cache
./home/.claude/session-env
./home/.claude.json.tmp.*
node_modules
.venv
venv
target
dist
build
.next
.turbo
__pycache__
.pytest_cache
.mypy_cache
EOF
}

# Each repo's git remote and HEAD, so the archive says what it is holding even
# before anyone extracts it. -uno on the status: the untracked scan walks every
# ignored node_modules on an NFS mount, and the tracked count answers the only
# question being asked here — was there uncommitted work in this tree.
repos_json() {
  first=1
  printf '['
  for d in "$DATA_DIR"/repos/*/; do
    [ -d "$d.git" ] || continue
    remote=$(git -C "$d" remote get-url origin 2>/dev/null || echo "")
    branch=$(git -C "$d" symbolic-ref --short HEAD 2>/dev/null || echo "")
    commit=$(git -C "$d" rev-parse HEAD 2>/dev/null || echo "")
    dirty=$(git -C "$d" status --porcelain -uno 2>/dev/null | wc -l | tr -d ' ')
    [ "$first" -eq 1 ] || printf ','
    first=0
    jq -nc --arg n "$(basename "$d")" --arg r "$remote" --arg b "$branch" \
           --arg c "$commit" --argjson d "${dirty:-0}" \
      '{name:$n,remote:$r,branch:$b,commit:$c,dirtyTracked:$d}'
  done
  printf ']'
}

# Timestamped to the second, and then past any collision. Two backups inside
# one second are rare but not impossible on a small volume, and without this the
# second silently overwrites the first while its checksum file is rewritten to
# match — a lost archive that leaves no trace of having been lost.
auto_name() {
  base=verksted-$(date +%Y%m%d-%H%M%S)
  n=$base.tar.gz
  i=2
  while [ -e "$1/$n" ]; do
    n=$base-$i.tar.gz
    i=$((i + 1))
  done
  printf '%s' "$n"
}

# Keep the N newest and drop the rest, with their checksums. Only the
# timestamp-named archives this script writes itself are eligible: a --name
# archive is somebody's deliberate keepsake, and whatever else is in the
# directory is not ours to delete.
prune() {
  n=0
  ls -1t "$1"/verksted-????????-??????*.tar.gz "$1"/verksted-????????-??????*.tar.gz.enc \
    2>/dev/null | while read -r f; do
    n=$((n + 1))
    [ "$n" -gt "$2" ] || continue
    rm -f "$f" "$f.sha256"
    echo "pruned $(basename "$f")"
  done
}

backup() {
  outdir=$BACKUP_DIR
  name=""
  keep=0
  while [ $# -gt 0 ]; do
    case $1 in
      --out) outdir=${2:?--out needs a directory}; shift 2 ;;
      --name) name=${2:?--name needs a file name}; shift 2 ;;
      --keep) keep=${2:?--keep needs a count}; shift 2 ;;
      *) die "backup: unknown option $1" ;;
    esac
  done
  case $keep in ''|*[!0-9]*) die "--keep wants a whole number, got '$keep'" ;; esac
  [ -d "$DATA_DIR" ] || die "$DATA_DIR does not exist"
  mkdir -p "$outdir"
  [ -n "$name" ] || name=$(auto_name "$outdir")
  # The suffix says what the file is before anything opens it: what prune
  # matches, what the panel lists, and what tells somebody holding the file on
  # another machine that a passphrase is part of reading it.
  case $name in
    *.enc) [ -n "$PASSPHRASE" ] || die "$name is named encrypted but no VK_BACKUP_PASSPHRASE is set" ;;
    *) [ -z "$PASSPHRASE" ] && : || name=$name.enc ;;
  esac

  # The share behind this mount is shared with every other PVC in the cluster,
  # so filling it is not a local mistake.
  avail=$(df -Pk "$outdir" | awk 'NR==2 {print $4}')
  [ "$avail" -ge "$MIN_FREE_KB" ] \
    || die "only $((avail / 1024))M free on $outdir, want $((MIN_FREE_KB / 1024))M"

  tmp=$(mktemp -d)
  out=$outdir/$name
  part=$out.partial
  trap 'rm -rf "$tmp" "$part"' EXIT

  image=$(kubectl get pod "$(uname -n)" \
    -o jsonpath='{.spec.containers[?(@.name=="verksted")].image}' 2>/dev/null || echo "")
  mkdir -p "$tmp/.verksted-backup"
  jq -n --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg hostname "$(uname -n)" \
        --arg image "$image" \
        --arg dataDir "$DATA_DIR" \
        --argjson repos "$(repos_json)" \
    '{version: 1, createdAt: $createdAt, hostname: $hostname, dataDir: $dataDir, repos: $repos}
     + (if $image == "" then {} else {image: $image} end)' \
    > "$tmp/.verksted-backup/MANIFEST.json"
  excludes > "$tmp/excludes"

  echo "packing $DATA_DIR -> $out"
  # The manifest goes in first so reading it back costs one member, not a whole
  # decompression pass (see --occurrence=1 below).
  #
  # Agents write to this volume the entire time this runs, so tar will say "file
  # changed as we read it" and exit 1. That is the normal case, not a failure —
  # a session's .state file flipping mid-read does not invalidate the archive.
  # Only exit 2 and up means tar could not do its job.
  rc=0
  # Encrypting is a second pass over a plain archive rather than a pipe: tar's
  # exit 1 above is the normal case and has to stay readable, and a `set -e`
  # shell without pipefail would swallow the distinction between that and a
  # tar that genuinely failed. The plain file is deleted either way, and the
  # free-space floor above already covers holding both for a moment.
  plain=$part
  [ -z "$PASSPHRASE" ] || plain=$part.plain
  tar -czf "$plain" -X "$tmp/excludes" --warning=no-file-changed \
      -C "$tmp" .verksted-backup \
      -C "$DATA_DIR" . || rc=$?
  [ "$rc" -le 1 ] || { rm -f "$plain"; die "tar failed (exit $rc)"; }

  if [ -n "$PASSPHRASE" ]; then
    chmod 0600 "$plain"
    encrypt "$plain" "$part" || { rm -f "$plain" "$part"; die "encrypting the archive failed"; }
    rm -f "$plain"
  fi

  chmod 0600 "$part"

  # Read it back the way a restore would, before anything old is pruned. An
  # archive that cannot be opened is not a backup, and finding that out on the
  # night you need it — after this run has already deleted the eighth-oldest —
  # is the failure this whole command exists to avoid.
  printf '%s' "$(read_manifest "$part")" | jq -e . >/dev/null 2>&1 \
    || die "wrote an archive that cannot be read back — left nothing pruned"

  mv "$part" "$out"
  ( cd "$outdir" && sha256sum "$name" > "$name.sha256" )
  chmod 0600 "$out.sha256"
  trap - EXIT
  rm -rf "$tmp"

  echo "wrote $out ($(du -h "$out" | cut -f1)), checksum in $out.sha256"
  [ "$keep" -eq 0 ] || prune "$outdir" "$keep"
  echo
  if [ -n "$PASSPHRASE" ]; then
    echo "encrypted with VK_BACKUP_PASSPHRASE. Every token, OAuth login and private"
    echo "key on the volume is in here, so the archive is worth exactly as much as"
    echo "that passphrase is secret — and worth nothing at all if it is lost. Keep"
    echo "it in a password manager, not on this volume."
  else
    echo "this archive holds every token, OAuth login and private key on the volume,"
    echo "unencrypted. It also sits on the same NAS share it is protecting — copy it"
    echo "somewhere else, and somewhere you would keep a password file."
    echo "Set VK_BACKUP_PASSPHRASE to encrypt what the next run writes."
  fi

  # Only worth printing where it would actually work: outside the pod there is
  # no namespace to name and no pod to name it after.
  ns=$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace 2>/dev/null || echo "")
  if [ -n "$ns" ]; then
    echo
    echo "  kubectl cp $ns/$(uname -n):${out#/} ./$name"
  fi
}

restore() {
  archive=""
  target=$DATA_DIR
  force=0
  while [ $# -gt 0 ]; do
    case $1 in
      --target) target=${2:?--target needs a directory}; shift 2 ;;
      --force) force=1; shift ;;
      -*) die "restore: unknown option $1" ;;
      *) [ -z "$archive" ] || die "restore: one archive at a time"; archive=$1; shift ;;
    esac
  done
  [ -n "$archive" ] || die "restore: which archive?"
  [ -f "$archive" ] || die "no such file: $archive"

  if [ -f "$archive.sha256" ]; then
    ( cd "$(dirname "$archive")" \
      && sha256sum -c --status "$(basename "$archive").sha256" ) \
      || die "checksum mismatch — $archive is not the file that was written"
  else
    echo "warning: no $archive.sha256 beside it, integrity unverified" >&2
  fi

  # An encrypted archive with no passphrase is a thing to say plainly, not a
  # missing manifest: the file is fine and this bench cannot open it.
  if is_encrypted "$archive" && [ -z "$PASSPHRASE" ]; then
    die "$archive is encrypted — set VK_BACKUP_PASSPHRASE to the passphrase it was written with"
  fi

  # Proves it is a verksted archive, and that the passphrase is right, before
  # anything gets overwritten. The manifest is the first member, and
  # --occurrence=1 stops tar there.
  manifest=$(read_manifest "$archive")
  printf '%s' "$manifest" | jq -e . >/dev/null 2>&1 \
    || die "$archive has no manifest — wrong passphrase, or not a vk backup archive"
  printf '%s' "$manifest" | jq -r '
    "archive   \(.createdAt)  from \(.hostname)\(if .image then " on \(.image)" else "" end)",
    "repos     \(.repos | length) (\(.repos | map(select(.dirtyTracked > 0)) | length) with uncommitted work)"'
  echo "target    $target"

  # A restore under a live app leaves it half old and half new: the backend has
  # settings.json open, and tmux is holding sessions whose metadata is being
  # replaced under them. Restoring anywhere else is nobody's problem, so this
  # only guards the volume the app is actually running on.
  if [ "$target" = "$DATA_DIR" ] && [ "$force" -eq 0 ]; then
    echo "vk: $target is the live volume, $(tmux ls 2>/dev/null | wc -l | tr -d ' ') tmux session(s) on it" >&2
    die "stop the app first, or pass --force if you mean it"
  fi

  mkdir -p "$target"
  # Extract merges. Files the archive does not carry are left where they are;
  # this restores what was backed up, it does not make $target identical to it.
  if is_encrypted "$archive"; then
    # The manifest read above already proved the passphrase, so a failure here
    # is tar's, not openssl's.
    decrypt "$archive" | tar -xpz -C "$target" || die "extract failed"
  else
    tar -xpzf "$archive" -C "$target" || die "extract failed"
  fi

  # tar preserves modes, but these are the ones that must be right whatever the
  # archive says — the same modes settings-store.ts and routes/ssh.ts write.
  for f in "$target/settings.json" "$target/push.json" \
           "$target/home/.claude/.credentials.json"; do
    if [ -f "$f" ]; then chmod 0600 "$f"; fi
  done
  if [ -d "$target/home/.ssh" ]; then
    chmod 0700 "$target/home/.ssh"
    find "$target/home/.ssh" -type f -exec chmod 0600 {} +
    find "$target/home/.ssh" -type f -name '*.pub' -exec chmod 0644 {} +
  fi

  echo
  echo "restored into $target"
  echo "restart the app: it reads settings.json at startup and rewrites the"
  echo "verksted blocks in \$HOME/.claude/CLAUDE.md on boot."
}

# One JSON array describing the directory, which is both what `vk backups`
# formats and what the settings page reads — the panel and the terminal cannot
# disagree about what is on disk because there is only one reader.
backups_json() {
  first=1
  printf '['
  for f in "$1"/*.tar.gz "$1"/*.tar.gz.enc; do
    [ -f "$f" ] || continue
    m=$(read_manifest "$f")
    printf '%s' "$m" | jq -e . >/dev/null 2>&1 || m=null
    enc=false
    ! is_encrypted "$f" || enc=true
    [ "$first" -eq 1 ] || printf ','
    first=0
    jq -nc --arg name "$(basename "$f")" --arg path "$f" \
           --arg size "$(du -h "$f" | cut -f1)" \
           --argjson bytes "$(stat -c %s "$f")" \
           --argjson mtime "$(stat -c %Y "$f")" \
           --argjson encrypted "$enc" \
           --argjson m "$m" \
      '{name: $name, path: $path, size: $size, bytes: $bytes, mtime: $mtime,
        encrypted: $encrypted}
       + (if $m == null then {createdAt: null, repos: null, dirty: null}
          else {createdAt: $m.createdAt,
                repos: ($m.repos | length),
                dirty: ($m.repos | map(select(.dirtyTracked > 0)) | length)} end)'
  done
  printf ']'
}

backups() {
  dir=$BACKUP_DIR
  json=0
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      -*) die "backups: unknown option $1" ;;
      *) dir=$1; shift ;;
    esac
  done
  out=$(backups_json "$dir")
  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$out"
    return
  fi
  if [ "$(printf '%s' "$out" | jq 'length')" -eq 0 ]; then
    echo "no archives in $dir"
    return
  fi
  # A .tar.gz someone else left here still gets a row, named, so it is not
  # mistaken for a backup.
  printf '%s' "$out" \
    | jq -r '.[] | [.name, .size, (.createdAt // "-"),
        (if .repos != null then "\(.repos) repos"
         elif .encrypted then "encrypted, no passphrase here"
         else "not a vk archive" end)] | @tsv' \
    | while IFS='	' read -r n sz when what; do
        printf '%-40s %7s  %-22s %s\n' "$n" "$sz" "$when" "$what"
      done
}

case "${1:-}" in
  doctor) doctor ;;
  feedback) shift; feedback "$@" ;;
  backup) shift; backup "$@" ;;
  restore) shift; restore "$@" ;;
  backups) shift; backups "$@" ;;
  *)
    usage
    exit 1
    ;;
esac
