{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  // e2e/ is here rather than in a project of its own: it imports the backend's
  // app and its playwright, so this is the tsconfig that already has both.
  // tsconfig.build.json excludes it, so nothing of it ships.
  "include": ["src", "test", "../shared", "../e2e"]
}
