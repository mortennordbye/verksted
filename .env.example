# Copy to .env (gitignored). In the cluster these come from External Secrets.

# --- server (defaults shown; usually no need to change) ---
PORT=8080
REPOS_DIR=/data/repos
SESSIONS_DIR=/data/sessions
# Recurring prompts created on the settings page persist here.
SCHEDULES_DIR=/data/schedules
# The assistant's chat threads: one JSONL per conversation.
ASSISTANT_DIR=/data/assistant
# What verksted has learned about how you work: one markdown file per fact.
MEMORY_DIR=/data/memory
# The council: one JSON file per member (name, remit, persona, tools).
COUNCIL_DIR=/data/council
# The assistant's model and reasoning effort (sessions are unaffected). These are
# the defaults; the settings page overrides both, and is the easier place to
# change them.
#ASSISTANT_MODEL=sonnet
#ASSISTANT_EFFORT=low
# Agent env vars set via the settings page persist here.
SETTINGS_FILE=/data/settings.json
# Timezone the cron patterns are read in, and the one every timestamp the
# assistant reports is rendered in. The image sets it, so this only needs
# changing for a bench somewhere else (default: Europe/Oslo).
#TZ=Europe/Oslo
# SSH keys added via the settings page land here (default: $HOME/.ssh).
#SSH_DIR=
# The assistant's voice, spoken on the pod (see backend/src/tts.ts). The model
# and its runtime are baked into the image at these paths; a dev box that has
# not got them answers "no voice here" and the browser reads replies instead.
# KOKORO_VOICE is the default the settings page shows; every voice the model has
# is listed there (af_heart is an American woman, bf_emma a British one).
#KOKORO_VOICE=af_heart
#KOKORO_PYTHON=/opt/kokoro/venv/bin/python
#KOKORO_SCRIPT=/etc/verksted/vk-say.py
#KOKORO_MODEL=/usr/local/share/kokoro/kokoro.onnx
#KOKORO_VOICES=/usr/local/share/kokoro/voices.bin
# Pino log level; "warn" stops per-request logging (default: info).
#LOG_LEVEL=info
# Browser origins allowed to make writes and open terminal websockets, on top of
# same-origin. Comma-separated scheme://host[:port]. Leave empty for the normal
# single-container deployment, where the UI and the API share an origin.
#ALLOWED_ORIGINS=

# --- notifications (optional) ---
# Web push needs no config: enable it per device on the settings page (iPhone:
# add the app to the Home Screen first, Safari tabs get no push). The VAPID
# keypair and the device subscriptions live here, on the data volume.
#PUSH_FILE=/data/push.json
# ntfy topic URL (e.g. https://ntfy.sh/your-private-topic). A second channel,
# for clients without web push. Empty = disabled.
NTFY_URL=
# App URL over the VPN (e.g. http://10.0.0.5:8080). When set, ntfy pushes
# deep-link straight into the session that wants attention.
PUBLIC_URL=

# --- agent credentials: consumed by the CLIs inside tmux, never by the backend ---
# Claude: generate with `claude setup-token` on a machine with a browser (valid ~1 year).
# NEVER set ANTHROPIC_API_KEY here: it silently overrides Max-plan auth and bills per token.
CLAUDE_CODE_OAUTH_TOKEN=

# Antigravity (agy): API key for headless auth. Alternatively run `agy` once
# interactively in the pod terminal; the OAuth token persists in $HOME on the PVC.
ANTIGRAVITY_API_KEY=

# Codex: API-billed. For ChatGPT-plan auth instead, run `codex login` once in the pod.
OPENAI_API_KEY=

# GitHub: used by gh (clone) and git push.
GH_TOKEN=

# Git author for commits made in session terminals (git reads these natively;
# no gitconfig needed). Committer should normally match author.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Headroom, the finance app one council advisor reads. Read by that advisor's
# MCP server, which inherits this environment — never by the backend. Set both
# or neither: without them the advisor keeps its persona and the web and simply
# has no headroom tools. The URL must be a hostname headroom's own ALLOWED_HOSTS
# accepts (its ingress host, not its cluster service name).
HEADROOM_URL=
HEADROOM_PASSWORD=
