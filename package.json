{
  "name": "verksted",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "npm run lint --workspaces && eslint . && npm run lint:runtime && npm run lint:shell && npm run format:check",
    "lint:runtime": "tsc --noEmit -p tsconfig.runtime.json",
    "lint:shell": "shellcheck runtime/vk runtime/vk-guard runtime/vk-signoff runtime/git-hooks/* .githooks/*",
    "test": "npm test --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
